<?xml version="1.0" encoding="utf-8"?>
<!--
    API 26+ composes the icon from these layers and applies its own mask, so the launcher decides
    the silhouette rather than the app. The flat .webp mipmaps beside this file are what older
    launchers and some system surfaces use; both are generated from the same mark.

    `<monochrome>` is the themed-icon layer (API 33+). It is a real requirement, not a nicety: a
    themed launcher tints the whole layer one flat colour, so any detail painted in the background
    colour disappears. The hole in the mark survives because it is a genuine hole in the path.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

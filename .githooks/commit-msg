#!/bin/sh
# Conventional Commits guard. Rejects a commit whose subject line doesn't start
# with a recognised type, e.g.  feat: ...   fix(chart): ...   feat!: ...
# This is what makes the automated versioning + CHANGELOG (release-please) work.
#
# Activate once per clone:  git config core.hooksPath .githooks
# Emergency bypass:         git commit --no-verify

msg_file="$1"
subject="$(head -n1 "$msg_file")"

# Let machine-generated / in-progress commits through untouched.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'

if printf '%s' "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'EOF'
✗ Commit rejected — the subject must follow Conventional Commits:

    <type>[optional scope][!]: <description>

  types:  feat fix docs style refactor perf test build ci chore revert
  add "!" (or a "BREAKING CHANGE:" footer) to mark a breaking change.

  examples:
    feat: add weight trend chart
    fix(reminders): stop exact alarms firing twice
    feat!: drop support for Android 7

Only feat / fix / feat! change the version. Fix the message and commit again
(or, if you truly must, re-run with  git commit --no-verify).
EOF
exit 1
